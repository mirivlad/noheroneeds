## A gathering tool's kind -> its picture ("" — by hand).
const TOOLS := {"": "glove", "chopping": "axe", "mining": "pick"}


## Which picture the actions call for.
static func kind_of(actions: Array[Dictionary]) -> String:
	var p := Actions.primary(actions)
	match String(p.get("id", "")):
		"shoot":
			return "bow"
		"craft_at":
			return "hammer"
		"gather":
			return TOOLS.get(String(p.get("tool", "")), "corners")
	if actions.any(func(a: Dictionary) -> bool: return a["id"] == "pickup"):
		return "glove"
	if String(p.get("id", "")) in ["strike", "swing"]:
		return "sword"
	return "corners"


## The picture of a kind, each of its pixels `scale` screen pixels.
static func texture(kind: String, scale: int) -> ImageTexture:
	return Art.glyph(String(GLYPHS[kind]["rows"]), PALETTE, INK, scale)


## Where the picture aims, in screen pixels.
static func hotspot(kind: String, scale: int) -> Vector2:
	return Vector2(GLYPHS[kind]["hot"] * scale + Vector2i(scale / 2, scale / 2))

